{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance iPhone Installer",
  "version": "1.0.0",
  "identifier": "mov.unblocked.resonance.iphone-installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Resonance iPhone Installer",
        "width": 720,
        "height": 620,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Install Resonance on an iPhone from Windows.",
    "icon": [
      "../../../../ios/Resonance/Assets.xcassets/AppIcon.appiconset/AppIcon.png",
      "../../../../windows/resonance.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
