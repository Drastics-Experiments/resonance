{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "ios/LikedSongsMobile/Assets.xcassets/AppIcon.appiconset/AppIcon.png",
  "scripts": [
    {
      "name": "Launch Windows Preview",
      "command": "zsh './Launch Windows.command'",
      "icon": "play"
    },
    {
      "name": "Test Windows",
      "command": "cd windows && corepack pnpm test",
      "icon": "test"
    },
    {
      "name": "Launch macOS Preview",
      "command": "zsh './Launch macOS.command'",
      "icon": "play"
    },
    {
      "name": "Test macOS",
      "command": "mac/scripts/test.sh",
      "icon": "test"
    },
    {
      "name": "Launch iOS Simulator",
      "command": "zsh './Launch iOS.command'",
      "icon": "play"
    },
    {
      "name": "Launch Android Emulator",
      "command": "zsh './Launch Android.command'",
      "icon": "play"
    },
    {
      "name": "Test Android",
      "command": "cd android && ./gradlew --no-daemon lintDebug testDebugUnitTest assembleDebug",
      "icon": "test"
    }
  ]
}
