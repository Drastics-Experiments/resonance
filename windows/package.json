{
  "name": "resonance-desktop",
  "version": "2.0.0",
  "resonanceBuild": 17,
  "resonanceDiscordApplicationID": "1535574125395841154",
  "resonanceUpdateAuthenticity": "production",
  "private": true,
  "type": "module",
  "description": "Shared Resonance Electron desktop app for Windows and macOS",
  "author": "Drastics Experiments",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "benchmark:library": "node benchmarks/library.mjs",
    "benchmark:renderer": "electron benchmarks/renderer.cjs",
    "preview:tailscale": "node remote-preview-server.mjs --tailscale",
    "package:win": "electron-builder --dir --win --x64 --publish never --config.directories.output=dist --config.extraMetadata.resonanceUpdateAuthenticity=unsigned",
    "installer:win": "electron-builder --win nsis --x64 --publish never --config.extraMetadata.resonanceUpdateAuthenticity=unsigned",
    "release:win": "electron-builder --win nsis --x64 --publish always --config.forceCodeSigning=true --config.extraMetadata.resonanceUpdateAuthenticity=production"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ffmpeg-static": "5.3.0",
    "music-metadata": "11.13.0"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "1.0.4",
    "@electron/packager": "20.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "mov.unblocked.resonance",
    "productName": "Resonance",
    "asar": true,
    "directories": {
      "output": "../installers/windows/dist"
    },
    "files": [
      "main.cjs",
      "async-work.cjs",
      "local-import-core.cjs",
      "local-debrid.cjs",
      "local-import-platform.cjs",
      "local-search.cjs",
      "local-soundcloud.cjs",
      "local-youtube.cjs",
      "library-paths.cjs",
      "local-files.cjs",
      "library-update-migration.cjs",
      "listening-history.cjs",
      "crash-safe-file.cjs",
      "discord-rpc.cjs",
      "download-file.cjs",
      "policy-lease.cjs",
      "filename-policy.cjs",
      "metadata.cjs",
      "provenance.cjs",
      "server-policy.cjs",
      "client-config.cjs",
      "client-config-state.cjs",
      "server-download.cjs",
      "server-request.cjs",
      "server-stream.cjs",
      "listen-along.cjs",
      "server-upload.cjs",
      "server-upload-response.cjs",
      "social-auth.cjs",
      "account-avatar.cjs",
      "mac-app-migration.cjs",
      "mac-update.cjs",
      "updater-feed.cjs",
      "response-body.cjs",
      "updater-auth.cjs",
      "update-channel.cjs",
      "preload.cjs",
      "package.json",
      "resonance.ico",
      "ui/**/*",
      "!ui/source-export.mjs"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "protocols": [
      {
        "name": "Resonance Account Sign-In",
        "schemes": [
          "resonance"
        ]
      }
    ],
    "win": {
      "icon": "resonance.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resonance",
      "artifactName": "Resonance-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Drastics-Experiments",
        "repo": "resonance"
      }
    ]
  }
}
